# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas (free M0 cluster) - get from cloud.mongodb.com
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/threads?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (free tier) - get from cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (test mode keys are free) - get from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# First admin account, created by "npm run seed:admin"
FIRST_ADMIN_EMAIL=owner@threads.pk
FIRST_ADMIN_PASSWORD=change_this_password
